{
  "name": "vscode-plain-sidebar",
  "displayName": "Plain Sidebar",
  "description": "Declutter the window with a plain and empty sidebar.",
  "publisher": "bithappens",
  "license": "MIT",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bithappens/vscode-plain-sidebar"
  },
  "icon": "static/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "empty",
    "focus",
    "declutter",
    "space",
    "simple",
    "minimal",
    "less is more",
    "hello world"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "plain-sidebar-container",
          "title": "Empty",
          "icon": "static/plainSidebar.svg"
        }
      ]
    },
    "views": {
      "plain-sidebar-container": [
        {
          "type": "webview",
          "id": "plain-sidebar",
          "name": "",
          "icon": "static/plainSidebar.svg"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "command": "workbench.view.extension.plain-sidebar-container"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run lint",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/vscode": ">=1.75.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}